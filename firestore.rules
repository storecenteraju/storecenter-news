rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows public read on posts, ads, settings, and automationLogs
    // Secure write requests are handled by authenticated queries or server backend proxy
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }
    match /feeds/{feedId} {
      allow read: if true;
      allow write: if true;
    }
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /automationLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /deletedPostItems/{deletedId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
