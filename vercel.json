{
  "version": 2,
  "builds": [
    {
      "src": "api/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.ts"
    },
    {
      "source": "/noticia/:slug",
      "destination": "/noticia/:slug/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
